# NYXforge — example environment config
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# ── ComfyUI launcher (used by `npm run dev:full`) ─────────────────────────
# Path to the ComfyUI subfolder (where main.py lives)
COMFYUI_PATH=C:\ComfyUI

# Path to the Python executable — for portable installs this is python_embeded\python.exe
COMFYUI_PYTHON=C:\ComfyUI\..\python_embeded\python.exe

# Extra flags passed to main.py (default works for portable Windows install)
# COMFYUI_ARGS=-s --windows-standalone-build --enable-cors-header

# Override if ComfyUI runs on a non-default URL/port
# COMFYUI_URL=http://127.0.0.1:8188

# ── Future server-side features ───────────────────────────────────────────
# RunPod credentials are entered in the app's Settings tab (localStorage).
# If you add auth, Stripe, etc. later, put API keys here.
# VERCEL_URL=nyxforge.com
